{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["transit"],
      "env": ["PAGES_BASE_PATH"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "STORYBOOK_PORT"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": ["CI", "E2E_PORT"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    }
  }
}
